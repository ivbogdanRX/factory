# ---- Meta (required to post ads) ----
# System-user token with ads_management + pages_show_list, assigned to the ad account & page.
META_SYSTEM_USER_TOKEN=
META_GRAPH_VERSION=v23.0

# ---- Slack (required for notifications + commands) ----
# Bot token (xoxb-...) with chat:write. App token (xapp-...) with connections:write for Socket Mode.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Channel where run notifications are posted (bot must be invited).
SLACK_CHANNEL_ID=
# Comma-separated Slack user IDs allowed to run /adops commands and press buttons.
SLACK_ALLOWED_USER_IDS=

# ---- RedTrack (conversion truth for guardrails) ----
# API key from RedTrack → Tools → Integrations → API. Guardrails use RedTrack
# conversions/revenue (attributed via sub1/sub3 in ad links) instead of Meta's.
REDTRACK_API_KEY=

# ---- Services ----
# Vendor creative studio (vendor/l_automation `npm run web`).
STUDIO_URL=http://127.0.0.1:5174
# Orchestrator API + portal.
ORCHESTRATOR_PORT=5180
# Where the Slack bot reaches the orchestrator.
ORCHESTRATOR_URL=http://127.0.0.1:5180

# ---- Vercel glance portal (optional, see portal-vercel/README.md) ----
# Push target on your Vercel deployment; leave empty to disable pushing.
PORTAL_PUSH_URL=
# Must match the PUSH_SECRET env var on the Vercel project.
PORTAL_PUSH_SECRET=

# ---- Meta write governor (account-integrity protection) ----
# Minimum seconds between Meta write calls; spreads any burst to a slow cadence.
META_WRITE_SPACING_SECONDS=20
# Rolling 24h ceilings: total write calls, and new campaigns created.
# A restriction/integrity error from Meta also trips a persistent circuit
# breaker that blocks all creation writes until cleared (pause/kill exempt).
META_MAX_WRITES_24H=80
META_MAX_CAMPAIGN_CREATES_24H=3

# ---- Behavior ----
# Hour of day (America/Los_Angeles) the daily run kicks off.
RUN_HOUR_PT=10
# 1 = generate creatives but skip all Meta writes (log what would happen).
DRY_RUN=0
