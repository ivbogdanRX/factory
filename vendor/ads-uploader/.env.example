# Copy this file to `.env` and fill in your own values.
#
# WARNING: Vite inlines every VITE_-prefixed variable into the client bundle at
# build time. Anything here is visible to anyone who loads the app — it is NOT a
# server-side secret. Only use keys you are willing to expose, and restrict them
# (HTTP referrer / API restrictions) at the provider.

# Meta app ID — public by design, safe to expose.
VITE_META_APP_ID=your_meta_app_id_here

# Shared Meta system-user access token (Business Manager → System users → Generate token).
# Available to every local app profile. Include ads_management, ads_read, pages_show_list
# and assign the ad accounts + pages you need.
VITE_META_SYSTEM_USER_TOKEN=your_system_user_token_here

# Google Gemini API key, used for AI creative analysis.
# Optional: users can instead supply their own key in-app, which is stored in
# localStorage under `ads_uploader_gemini_key` and takes precedence over this.
VITE_GEMINI_API_KEY=your_gemini_api_key_here
