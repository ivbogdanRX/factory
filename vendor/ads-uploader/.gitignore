# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Environment — NEVER commit these.
# VITE_-prefixed vars are inlined into the client bundle at build time,
# so anything here ships to every browser. Keep real keys out of the repo.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
